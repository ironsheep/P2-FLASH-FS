// See https://aka.ms/vscode-remote/devcontainer.json for format details.
{
  "name": "P2-FLASH-FS Development",
  "dockerComposeFile": ["docker-compose.yml", "docker-compose.override.yml"],
  "service": "dev",
  "workspaceFolder": "/workspaces/P2-FLASH-FS",
  "containerEnv": {
    // Relocates git's GLOBAL config away from ~/.gitconfig, which the Dev Containers
    // extension copies from the macOS host at every container start and which would
    // otherwise outrank (system < global) the identity baked into /etc/gitconfig. Set
    // here, not in .bashrc, so it reaches every process rather than only login shells.
    // Full reasoning: .devcontainer/Dockerfile.
    "GIT_CONFIG_GLOBAL": "/home/node/.config/git/config",
    "LANG": "en_US.UTF-8",
    "LC_ALL": "en_US.UTF-8"
  },
  "remoteUser": "node",
  // Runs on the host before every open and rebuild:
  //   1. creates an empty local override if there is none, so the container always starts;
  //   2. if local image additions exist, writes Dockerfile.local = this Dockerfile + them
  //      (both local files are gitignored);
  //   3. builds the image the compose file names. Built here, not by a compose `build:`,
  //      because the Dev Containers extension builds a compose service from a generated
  //      Dockerfile in the macOS temp folder, which buildx >= 0.37.2 refuses to read
  //      ("additional privileges requested: --allow=fs.read=..."). An image-only service
  //      is used as-is. For the same reason there are no `features`. Cached layers make
  //      this about a second when nothing changed; to force a fresh build, run the same
  //      `docker build` with --no-cache.
  "initializeCommand": "test -f .devcontainer/docker-compose.override.yml || echo 'services: {}' > .devcontainer/docker-compose.override.yml; DF=Dockerfile; if [ -f .devcontainer/Dockerfile.local-additions ]; then cat .devcontainer/Dockerfile .devcontainer/Dockerfile.local-additions > .devcontainer/Dockerfile.local; DF=Dockerfile.local; fi; docker build -f .devcontainer/$DF --build-arg LOCAL_USER=node -t p2-flash-fs-dev:local .devcontainer",
  // A fresh named volume mounts root-owned, hence the chown. The ssh keys arrive
  // read-only at /tmp/.ssh; they are copied so their modes can be set, and the macOS
  // paths and the macOS-only UseKeychain option in ~/.ssh/config are rewritten.
  "postCreateCommand": "sudo chown -R node:node /home/node/.local 2>/dev/null || true; mkdir -p ~/.ssh && cp /tmp/.ssh/* ~/.ssh/ 2>/dev/null; chmod 700 ~/.ssh && chmod 600 ~/.ssh/id_* 2>/dev/null; chmod 644 ~/.ssh/*.pub 2>/dev/null; sed -i -e 's#/Users/stephen/\\.ssh/#/home/node/.ssh/#g' -e 's|^\\([[:space:]]*\\)UseKeychain|\\1#UseKeychain|' ~/.ssh/config 2>/dev/null || true;",
  "customizations": {
    "vscode": {
      "extensions": [
        "ironsheepproductionsllc.spin2",
        "github.vscode-pull-request-github",
        "eamodio.gitlens",
        "davidanson.vscode-markdownlint",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "files.eol": "\n",
        "editor.tabSize": 4,
        "files.trimTrailingWhitespace": true
      }
    }
  }
}
