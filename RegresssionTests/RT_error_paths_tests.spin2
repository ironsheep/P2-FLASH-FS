PRI testModeMismatches() | handle, callIdx
' Make calls a handle's open mode does not allow: the write calls on a read handle, the read calls and seek() on a write and an append handle.

' Local Variables:
' @local handle - handle of the file being tested
' @local callIdx - number of the handle call being made

    utils.startTestGroup(@"calls the open mode does not allow")

    handle := openFor(@dataFile, flash.FILEMODE_READ, @"open(,r) a read handle for the write calls")
    repeat callIdx from HM_WRITE to HM_WR_STR
        refusedCall(callIdx, handle)
    refusedCall(HM_FLUSH, handle)
    utils.startTest(@"close() of the read handle")
    closeSub(handle)

    handle := openFor(@newFile, flash.FILEMODE_WRITE, @"open(,w) a write handle for the read calls")
    readSideRefused(handle)
    utils.startTest(@"close() of the write handle")
    closeSub(handle)

    handle := openFor(@otherFile, flash.FILEMODE_APPEND, @"open(,a) an append handle for the read calls")
    readSideRefused(handle)
    utils.startTest(@"close() of the append handle")
    closeSub(handle)


PRI readSideRefused(handle) | callIdx
' Make the read calls and seek() on a handle that was opened without reading.

' @param handle - handle of a file opened to write or to append

' Local Variables:
' @local callIdx - number of the handle call being made

    refusedCall(HM_SEEK, handle)
    repeat callIdx from HM_READ to HM_RD_STR
        refusedCall(callIdx, handle)


PRI refusedCall(methodIdx, handle)
' Make one handle call as a test that passes when the call fails with E_FILE_MODE.

' @param methodIdx - number of the handle call to make
' @param handle - handle the open mode of which the call does not allow

    utils.startTest(handleMethodName(methodIdx))
    checkValue(callHandleMethod(methodIdx, handle), expectedReturn(methodIdx, flash.E_FILE_MODE), flash.E_FILE_MODE)


PRI testReadResults() | handle
' Reads that reach the end of a file, on a file that is not a whole number of LONGs.

' Local Variables:
' @local handle - handle of the tiny file

    utils.startTestGroup(@"reads that reach the end of a file")
    handle := openFor(@tinyFile, flash.FILEMODE_READ, @"open(,r) the tiny file")

    utils.startTest(@"rd_long() with fewer than four bytes left returns 0")
    checkValue(flash.rd_long(handle), 0, flash.E_END_OF_FILE)

    utils.startTest(@"rd_word() of the first two bytes")
    flash.seek(handle, 0, flash.SK_FILE_START)
    setPendingError()
    checkValue(flash.rd_word(handle), TINY_WORD, flash.SUCCESS)

    utils.startTest(@"rd_word() with one byte left")
    checkStatus(flash.rd_word(handle), flash.E_END_OF_FILE, flash.E_END_OF_FILE)

    utils.startTest(@"rd_byte() at the end of the file")
    flash.seek(handle, TINY_BYTES, flash.SK_FILE_START)
    checkStatus(flash.rd_byte(handle), flash.E_END_OF_FILE, flash.E_END_OF_FILE)

    utils.startTest(@"rd_word() at the end of the file")
    checkStatus(flash.rd_word(handle), flash.E_END_OF_FILE, flash.E_END_OF_FILE)

    utils.startTest(@"rd_long() at the end of the file returns 0")
    checkValue(flash.rd_long(handle), 0, flash.E_END_OF_FILE)

    utils.startTest(@"read() at the end of the file")
    checkValue(flash.read(handle, @readBuf, DATA_BYTES), NO_BYTES, flash.E_END_OF_FILE)

    utils.startTest(@"read() of more bytes than the file holds")
    flash.seek(handle, 0, flash.SK_FILE_START)
    checkValue(flash.read(handle, @readBuf, DATA_BYTES), TINY_BYTES, flash.E_END_OF_FILE)

    utils.startTest(@"read() of exactly the bytes the file holds")
    flash.seek(handle, 0, flash.SK_FILE_START)
    setPendingError()
    checkValue(flash.read(handle, @readBuf, TINY_BYTES), TINY_BYTES, flash.SUCCESS)

    utils.startTest(@"close() of the tiny file")
    closeSub(handle)


PRI testStringReads() | handle, errCode, byteCount
' Read the three strings of the string file with buffers that are too small, big enough, and then reach the end of the file.

' Local Variables:
' @local handle - handle of the string file
' @local errCode - error() after the call
' @local byteCount - what rd_str() returned

    utils.startTestGroup(@"strings read with rd_str()")
    handle := openFor(@stringFile, flash.FILEMODE_READ, @"open(,r) the string file")

    utils.startTest(@"rd_str() of a string that fits")
    setPendingError()
    byteCount := flash.rd_str(handle, @stringBuf, STRING_BUF_BYTES)
    errCode := flash.error()
    utils.evaluateSubValue(byteCount, @"bytes read", strsize(@firstText))
    utils.evaluateSubValue(strcomp(@stringBuf, @firstText), @"string read", TRUE)
    utils.evaluateSubStatus(errCode, @"error() after rd_str()", flash.SUCCESS)

    utils.startTest(@"rd_str() into a buffer that is too small")
    byteCount := flash.rd_str(handle, @stringBuf, TRUNCATE_BUF_BYTES)
    errCode := flash.error()
    utils.evaluateSubValue(byteCount, @"bytes read", TRUNCATE_BUF_BYTES - TERMINATOR_BYTES)
    utils.evaluateSubValue(strsize(@stringBuf), @"length of the string placed in the buffer", TRUNCATE_BUF_BYTES - TERMINATOR_BYTES)
    utils.evaluateSubStatus(errCode, @"error() after rd_str()", flash.E_TRUNCATED_STRING)

    utils.startTest(@"rd_str() of the rest of the truncated string")
    setPendingError()
    byteCount := flash.rd_str(handle, @stringBuf, STRING_BUF_BYTES)
    errCode := flash.error()
    utils.evaluateSubValue(byteCount, @"bytes read", strsize(@secondText) - TRUNCATE_BUF_BYTES)
    utils.evaluateSubStatus(errCode, @"error() after rd_str()", flash.SUCCESS)

    utils.startTest(@"rd_str() of a string whose terminator is missing")
    byteCount := flash.rd_str(handle, @stringBuf, STRING_BUF_BYTES)
    errCode := flash.error()
    utils.evaluateSubValue(byteCount, @"bytes read", TAIL_TEXT_BYTES)
    utils.evaluateSubValue(strsize(@stringBuf), @"length of the string placed in the buffer", TAIL_TEXT_BYTES)
    utils.evaluateSubStatus(errCode, @"error() after rd_str()", flash.E_INCOMPLETE_STRING)

    utils.startTest(@"rd_str() at the end of the file")
    byteCount := flash.rd_str(handle, @stringBuf, STRING_BUF_BYTES)
    errCode := flash.error()
    utils.evaluateSubValue(byteCount, @"bytes read", NO_BYTES)
    utils.evaluateSubStatus(errCode, @"error() after rd_str()", flash.E_END_OF_FILE)

    utils.startTest(@"close() of the string file")
    closeSub(handle)


PRI testSeekCodes() | handle
' Every code seek() reports on a read handle: a position out of range, a whence that does not exist, and the last position.

' Local Variables:
' @local handle - handle of the data file

    utils.startTestGroup(@"seek() codes")
    handle := openFor(@dataFile, flash.FILEMODE_READ, @"open(,r) the data file to seek in")

    utils.startTest(@"seek() to a position below the first byte")
    checkStatus(flash.seek(handle, BEFORE_FIRST_BYTE, flash.SK_FILE_START), flash.E_FILE_SEEK, flash.E_FILE_SEEK)

    utils.startTest(@"seek() to a position past the end of the file")
    checkStatus(flash.seek(handle, DATA_BYTES + BYTE_SIZE, flash.SK_FILE_START), flash.E_FILE_SEEK, flash.E_FILE_SEEK)

    utils.startTest(@"seek() with a whence of zero")
    checkStatus(flash.seek(handle, 0, flash.SK_Unknown), flash.E_BAD_SEEK_ARG, flash.E_BAD_SEEK_ARG)

    utils.startTest(@"seek() with the whence above the last one")
    checkStatus(flash.seek(handle, 0, WHENCE_PAST_LAST), flash.E_BAD_SEEK_ARG, flash.E_BAD_SEEK_ARG)

    utils.startTest(@"seek() to the last position of the file")
    setPendingError()
    checkValue(flash.seek(handle, DATA_BYTES, flash.SK_FILE_START), DATA_BYTES, flash.SUCCESS)

    utils.startTest(@"close() of the data file")
    closeSub(handle)


PRI testWriteFromOtherCog() | writeHandle, readHandle, pending, workerCog, waitLimit
' Call write() from a cog other than the first: the results and error() are those of the cog that called, and the first cog's pending code is left alone.

' Local Variables:
' @local writeHandle - handle of the file the worker cog writes zero bytes to
' @local readHandle - handle of the file the worker cog fails to write to
' @local pending - code the first cog has pending while the worker runs
' @local workerCog - number of the cog the worker runs in
' @local waitLimit - time at which the wait for the worker ends

    utils.startTestGroup(@"write() called from another cog")
    writeHandle := openFor(@newFile, flash.FILEMODE_WRITE, @"open(,w) a handle the worker writes zero bytes to")
    readHandle := openFor(@dataFile, flash.FILEMODE_READ, @"open(,r) a handle the worker fails to write to")

    utils.startTest(@"write() of the worker cog reports the code of the worker cog")
    workWriteHandle := writeHandle
    workReadHandle := readHandle
    workDone := FALSE
    pending := setPendingError()
    workerCog := cogspin(NEWCOG, writeWorker(), @workStack)
    utils.evaluateSubValue(workerCog >= 0, @"worker cog started", TRUE)
    waitLimit := getms() + WORKER_WAIT_MS
    repeat until workDone
        if getms() - waitLimit > 0                      ' signed difference, so a wrap of the millisecond count is harmless
            quit
        waitms(WORKER_POLL_MS)
    utils.evaluateSubValue(workDone, @"worker cog finished", TRUE)
    utils.evaluateSubValue(workZeroResult, @"write() of zero bytes", NO_BYTES)
    utils.evaluateSubStatus(workZeroError, @"error() of the worker after zero bytes", flash.SUCCESS)
    utils.evaluateSubStatus(workBadResult, @"write() with a handle that is no handle", flash.E_BAD_HANDLE)
    utils.evaluateSubStatus(workBadError, @"error() of the worker after the bad handle", flash.E_BAD_HANDLE)
    utils.evaluateSubStatus(workModeResult, @"write() to a read handle", flash.E_FILE_MODE)
    utils.evaluateSubStatus(workModeError, @"error() of the worker after the read handle", flash.E_FILE_MODE)

    utils.startTest(@"the calls of the worker cog left the code of the first cog alone")
    utils.evaluateSubStatus(flash.error(), @"error() of the first cog", pending)

    utils.startTest(@"close() of the handles the worker used")
    closeSub(writeHandle)
    closeSub(readHandle)


PRI writeWorker()
' Run in its own cog: call write() with a count of zero, with a handle that is no handle and with a read handle, and record what each returned and what error() held.

    workZeroResult := flash.write(workWriteHandle, @oneByte, NO_BYTES)
    workZeroError := flash.error()
    workBadResult := flash.write(BAD_HANDLE_VALUE, @oneByte, BYTE_SIZE)
    workBadError := flash.error()
    workModeResult := flash.write(workReadHandle, @oneByte, BYTE_SIZE)
    workModeError := flash.error()
    workDone := TRUE


PRI testTransferCounts() | handle
' read(), write() and rd_str() with a count of zero move nothing and succeed, and with a count below zero move nothing and refuse.

' Local Variables:
' @local handle - handle of the file being used

    utils.startTestGroup(@"read(), write() and rd_str() with a count of zero or below")

    handle := openFor(@dataFile, flash.FILEMODE_READ, @"open(,r) a file for the read counts")
    utils.startTest(@"read() with a count of zero moves no bytes and succeeds")
    readBuf[0] := UNTOUCHED_BYTE
    checkValue(flash.read(handle, @readBuf, NO_BYTES), NO_BYTES, flash.SUCCESS)
    utils.evaluateSubValue(readBuf[0], @"first byte of the buffer", UNTOUCHED_BYTE)
    utils.startTest(@"read() with a count below zero moves no bytes and refuses")
    readBuf[0] := UNTOUCHED_BYTE
    checkValue(flash.read(handle, @readBuf, NEGATIVE_COUNT), NO_BYTES, flash.E_BAD_FILE_LENGTH)
    utils.evaluateSubValue(readBuf[0], @"first byte of the buffer", UNTOUCHED_BYTE)
    utils.startTest(@"close() of the file the read counts used")
    closeSub(handle)

    handle := openFor(@stringFile, flash.FILEMODE_READ, @"open(,r) a file for the rd_str counts")
    utils.startTest(@"rd_str() with a count of zero moves no bytes and succeeds")
    stringBuf[0] := UNTOUCHED_BYTE
    checkValue(flash.rd_str(handle, @stringBuf, NO_BYTES), NO_BYTES, flash.SUCCESS)
    utils.evaluateSubValue(stringBuf[0], @"first byte of the buffer", UNTOUCHED_BYTE)
    utils.startTest(@"rd_str() with a count below zero moves no bytes and refuses")
    checkValue(flash.rd_str(handle, @stringBuf, NEGATIVE_COUNT), NO_BYTES, flash.E_BAD_FILE_LENGTH)
    utils.evaluateSubValue(stringBuf[0], @"first byte of the buffer", UNTOUCHED_BYTE)
    utils.startTest(@"close() of the file the rd_str counts used")
    closeSub(handle)

    handle := openFor(@newFile, flash.FILEMODE_WRITE, @"open(,w) a file for the write counts")
    utils.startTest(@"write() with a count of zero moves no bytes and succeeds")
    checkValue(flash.write(handle, @dataBuf, NO_BYTES), NO_BYTES, flash.SUCCESS)
    utils.startTest(@"write() with a count below zero moves no bytes and returns E_BAD_FILE_LENGTH")
    checkValue(flash.write(handle, @dataBuf, NEGATIVE_COUNT), flash.E_BAD_FILE_LENGTH, flash.E_BAD_FILE_LENGTH)
    utils.startTest(@"close() of the file the write counts used")
    closeSub(handle)


PRI testCreateFileLength()
' create_file() with a length of zero and below: it makes no file and says why.

    utils.startTestGroup(@"create_file() with a length of zero or below")
    createLengthCase(@"create_file() with a length of zero", @zeroLenFile, ZERO_LENGTH)
    createLengthCase(@"create_file() with a length below zero", @negLenFile, NEGATIVE_LENGTH)
    formatFresh(@"format() to clear any file the cases made")


PRI createLengthCase(pTitle, pFilename, byteCount) | status, errCode, bFound, filesBefore, filesAfter
' Call create_file() with a length that is no length, and check it refused, said so, and made no directory entry.

' @param pTitle - address of zstring naming the test
' @param pFilename - address of zstring with the name to create
' @param byteCount - the length to ask for

' Local Variables:
' @local status - what create_file() returned
' @local errCode - error() after create_file()
' @local bFound - TRUE when a file of that name exists afterward
' @local filesBefore - files in the directory before the call
' @local filesAfter - files in the directory after the call

    utils.startTest(pTitle)
    _, _, filesBefore := flash.stats()
    status := flash.create_file(pFilename, CREATE_FILL, byteCount)
    errCode := flash.error()
    bFound := flash.exists(pFilename)
    _, _, filesAfter := flash.stats()
    utils.evaluateSubStatus(status, @"create_file()", flash.E_BAD_FILE_LENGTH)
    utils.evaluateSubStatus(errCode, @"error() after create_file()", flash.E_BAD_FILE_LENGTH)
    utils.evaluateSubValue(bFound, @"exists() of the name", FALSE)
    utils.evaluateSubValue(filesAfter, @"files in the directory", filesBefore)


PRI testBadHandles() | methodIdx
' Every handle call, but file_size_for_handle(), with every kind of handle outside the range of handles.

' Local Variables:
' @local methodIdx - number of the handle call being made

    utils.startTestGroup(@"handles outside the range of handles")
    repeat HM_FILE_SIZE_FOR_HANDLE with methodIdx
        utils.startTest(handleMethodName(methodIdx))
        checkBadHandles(methodIdx)


PRI checkBadHandles(methodIdx) | kindIdx, handle
' Make one handle call with each kind of bad handle, naming the handle before its results.

' @param methodIdx - number of the handle call to make

' Local Variables:
' @local kindIdx - number of the kind of bad handle
' @local handle - the bad handle

    repeat BAD_HANDLE_KINDS with kindIdx
        handle := badHandle(kindIdx)
        debug("  bad handle ", sdec_(handle))
        checkValue(callHandleMethod(methodIdx, handle), expectedReturn(methodIdx, flash.E_BAD_HANDLE), flash.E_BAD_HANDLE)


PRI testNeverOpenedHandle()
' Close and flush a handle that no open() gave out since the filesystem was mounted.

    utils.startTestGroup(@"a handle that was never opened")
    remountCase(@"unmount() and mount() give every handle back")

    utils.startTest(@"close() of a handle that was never opened")
    checkStatus(flash.close(utils.FIRST_HANDLE), flash.E_BAD_HANDLE, flash.E_BAD_HANDLE)

    utils.startTest(@"flush() of a handle that was never opened")
    checkStatus(flash.flush(utils.FIRST_HANDLE), flash.E_BAD_HANDLE, flash.E_BAD_HANDLE)

    remountCase(@"unmount() and mount() give every handle back")


PRI testFileSizeBadHandles() | kindIdx, handle
' file_size_for_handle() with every kind of handle outside the range of handles.

' Local Variables:
' @local kindIdx - number of the kind of bad handle
' @local handle - the bad handle

    utils.startTestGroup(@"file_size_for_handle() with a handle outside the range")
    debug("* The next calls pass a handle outside the range to a call that may not check it")
    utils.startTest(handleMethodName(HM_FILE_SIZE_FOR_HANDLE))
    repeat BAD_HANDLE_KINDS with kindIdx
        handle := badHandle(kindIdx)
        debug("  bad handle ", sdec_(handle))
        checkStatus(flash.file_size_for_handle(handle), flash.E_BAD_HANDLE, flash.E_BAD_HANDLE)


PRI testPoolAfterDoubleClose() | handle, dumpBytes, mismatchIdx
' Close a handle twice, then open every handle and one more: the handle pool still has exactly the handles it has,
' and the open that has none left changes nothing the dump of the handle status bytes and their neighbours holds.

' Local Variables:
' @local handle - handle that is closed twice
' @local dumpBytes - bytes a handle status dump returned
' @local mismatchIdx - offset of the first byte that differs between the two dumps

    utils.startTestGroup(@"the handle pool after a handle is closed twice")
    debug("* The next calls may damage driver state outside the handle arrays")
    remountCase(@"unmount() and mount() give every handle back")

    handle := openFor(@newFile, flash.FILEMODE_WRITE, @"open(,w) a handle to close twice")
    utils.startTest(@"first close() of the handle")
    closeSub(handle)

    utils.startTest(@"second close() of the same handle")
    checkStatus(flash.close(handle), flash.E_BAD_HANDLE, flash.E_BAD_HANDLE)

    utils.startTest(@"flush() of the closed handle")
    checkStatus(flash.flush(handle), flash.E_BAD_HANDLE, flash.E_BAD_HANDLE)

    openAllHandles()

    utils.startTest(@"dump of the handle status bytes with every handle open")
    dumpBytes := flash.TEST_getHandleStatusDump(@dumpBefore, GUARD_BYTES)
    utils.evaluateSubValue(dumpBytes, @"bytes dumped", DUMP_BYTES)

    utils.startTest(@"open() with every handle in use")
    checkStatus(flash.open(@extraFile, flash.FILEMODE_WRITE), flash.E_NO_HANDLE, flash.E_NO_HANDLE)

    utils.startTest(@"the dump of the handle status bytes is the same after that open")
    dumpBytes := flash.TEST_getHandleStatusDump(@dumpAfter, GUARD_BYTES)
    mismatchIdx := firstMismatch(@dumpBefore, @dumpAfter, DUMP_BYTES)
    utils.evaluateSubValue(dumpBytes, @"bytes dumped", DUMP_BYTES)
    utils.evaluateSubValue(mismatchIdx, @"offset of the first byte that differs", NO_MISMATCH)
    if mismatchIdx <> NO_MISMATCH
        debug("*   dump byte ", sdec_(mismatchIdx), " was ", uhex_byte_(BYTE[@dumpBefore][mismatchIdx]), ", is ", uhex_byte_(BYTE[@dumpAfter][mismatchIdx]))

    closeAllHandles()
    remountCase(@"unmount() and mount() give every handle back")


PRI setPendingError() : code
' Leave E_FILE_NOT_FOUND in error() by opening a file that does not exist, and check that it got there.

' @returns code - the code open() returned

    code := flash.open(@missingFile, flash.FILEMODE_READ)
    utils.evaluateSubStatus(flash.error(), @"setup: the pending code", flash.E_FILE_NOT_FOUND)


PRI checkStatus(returned, expectedStatus, expectedCode) | errCode
' Check the status a call returned and the error() it left.

' @param returned - the status the call returned
' @param expectedStatus - the status the call must return
' @param expectedCode - the code error() must hold

' Local Variables:
' @local errCode - error() as the call left it

    errCode := flash.error()
    utils.evaluateSubStatus(returned, @"status returned", expectedStatus)
    utils.evaluateSubStatus(errCode, @"error() after the call", expectedCode)


PRI checkValue(returned, expectedValue, expectedCode) | errCode
' Check the count or value a call returned and the error() it left.

' @param returned - the count or value the call returned
' @param expectedValue - the count or value the call must return
' @param expectedCode - the code error() must hold

' Local Variables:
' @local errCode - error() as the call left it

    errCode := flash.error()
    utils.evaluateSubValue(returned, @"value returned", expectedValue)
    utils.evaluateSubStatus(errCode, @"error() after the call", expectedCode)


PRI formatFresh(pTitle) | status, errCode
' Format the flash as a test that passes when format() and error() both report SUCCESS.

' @param pTitle - address of zstring naming the test

' Local Variables:
' @local status - what format() returned
' @local errCode - error() after format()

    utils.startTest(pTitle)
    status := flash.format()
    errCode := flash.error()
    utils.evaluateSubStatus(status, @"format()", flash.SUCCESS)
    utils.evaluateSubStatus(errCode, @"error() after format()", flash.SUCCESS)


PRI remountCase(pTitle)
' Unmount and mount as a test, which gives every handle back to the pool.

' @param pTitle - address of zstring naming the test

    utils.startTest(pTitle)
    checkStatus(flash.unmount(), flash.SUCCESS, flash.SUCCESS)
    checkStatus(flash.mount(), flash.SUCCESS, flash.SUCCESS)


PRI openSub(pFilename, mode) : handle | errCode
' Open a file inside a running test, and check open() returned a handle and error() holds SUCCESS.

' @param pFilename - address of zstring with the file name
' @param mode - open mode
' @returns handle - handle from open(), or a negative error code

' Local Variables:
' @local errCode - error() after open()

    handle := flash.open(pFilename, mode)
    errCode := flash.error()
    utils.evaluateSubValue(isUsableHandle(handle), @"open() returned a usable handle", TRUE)
    utils.evaluateSubStatus(errCode, @"error() after open()", flash.SUCCESS)


PRI openFor(pFilename, mode, pTitle) : handle
' Open a file as a test that passes when open() returned a handle and error() holds SUCCESS.

' @param pFilename - address of zstring with the file name
' @param mode - open mode
' @param pTitle - address of zstring naming the test
' @returns handle - handle from open(), or a negative error code

    utils.startTest(pTitle)
    handle := openSub(pFilename, mode)


PRI closeSub(handle) | status, errCode
' Close a handle inside a running test, and check close() and error() both report SUCCESS.

' @param handle - handle to close

' Local Variables:
' @local status - what close() returned
' @local errCode - error() after close()

    status := utils.closeHandle(handle)
    errCode := flash.error()
    utils.evaluateSubStatus(status, @"close()", flash.SUCCESS)
    utils.evaluateSubStatus(errCode, @"error() after close()", flash.SUCCESS)


PRI modeSucceeds(pTitle, pFilename, mode, limitBytes) | handle
' Open a file in a mode with a failure code pending, then close it, as one test; a limit above zero opens it circular.

' @param pTitle - address of zstring naming the test
' @param pFilename - address of zstring with the file name
' @param mode - open mode
' @param limitBytes - circular limit, or 0 for a handle that is not circular

' Local Variables:
' @local handle - handle of the file

    utils.startTest(pTitle)
    setPendingError()
    if limitBytes > 0
        handle := flash.open_circular(pFilename, mode, limitBytes)
        utils.evaluateSubValue(isUsableHandle(handle), @"open_circular() returned a usable handle", TRUE)
        utils.evaluateSubStatus(flash.error(), @"error() after open_circular()", flash.SUCCESS)
    else
        handle := openSub(pFilename, mode)
    closeSub(handle)


PRI createFile(pTitle, pFilename, pBuffer, byteCount) | handle, writeCount, errCode
' Write bytes to a new file opened with "w" and close it, as one test.

' @param pTitle - address of zstring naming the test
' @param pFilename - address of zstring with the file name
' @param pBuffer - address of the bytes to write
' @param byteCount - number of bytes to write

' Local Variables:
' @local handle - handle of the file being written
' @local writeCount - what write() returned
' @local errCode - error() after write()

    utils.startTest(pTitle)
    handle := openSub(pFilename, flash.FILEMODE_WRITE)
    writeCount := flash.write(handle, pBuffer, byteCount)
    errCode := flash.error()
    utils.evaluateSubValue(writeCount, @"write()", byteCount)
    utils.evaluateSubStatus(errCode, @"error() after write()", flash.SUCCESS)
    closeSub(handle)


PRI openAllHandles() | slotIdx, errCode
' Open a new file with every handle the driver has, one test each, and keep the handles.

' Local Variables:
' @local slotIdx - number of the handle being opened
' @local errCode - error() after open()

    repeat flash.MAX_FILES_OPEN with slotIdx
        utils.startTest(@"open(,w) takes a handle while one is free")
        setFillName(slotIdx)
        heldHandles[slotIdx] := flash.open(@fillFile, flash.FILEMODE_WRITE)
        errCode := flash.error()
        utils.evaluateSubValue(isUsableHandle(heldHandles[slotIdx]), @"open() returned a usable handle", TRUE)
        utils.evaluateSubValue(isNewHandle(slotIdx), @"handle differs from the handles already held", TRUE)
        utils.evaluateSubStatus(errCode, @"error() after open()", flash.SUCCESS)


PRI closeAllHandles() | slotIdx
' Close every handle openAllHandles() kept, one test each.

' Local Variables:
' @local slotIdx - number of the handle being closed

    repeat flash.MAX_FILES_OPEN with slotIdx
        utils.startTest(@"close() gives a handle back to the pool")
        closeSub(heldHandles[slotIdx])


PRI setFillName(slotIdx)
' Put the number of a handle slot, as two digits, in the name of the file that fills the slot.

' @param slotIdx - number of the handle slot, from 0 to 99

    BYTE[@fillFile][FILL_TENS_OFFSET] := "0" + (slotIdx / NAME_DIGIT_RADIX)
    BYTE[@fillFile][FILL_ONES_OFFSET] := "0" + (slotIdx +// NAME_DIGIT_RADIX)


PRI isUsableHandle(handle) : bUsable
' Tell whether a value is one of the handles open() hands out.

' @param handle - value open() returned
' @returns bUsable - TRUE when the value is inside the range of handles

    bUsable := handle >= utils.FIRST_HANDLE and handle < utils.FIRST_HANDLE + flash.MAX_FILES_OPEN


PRI isNewHandle(slotIdx) : bNew | priorIdx
' Tell whether the handle held in a slot differs from the handles held in the slots before it.

' @param slotIdx - number of the slot to compare
' @returns bNew - TRUE when no earlier slot holds the same handle

' Local Variables:
' @local priorIdx - number of the earlier slot being compared

    bNew := TRUE
    repeat slotIdx with priorIdx
        if heldHandles[priorIdx] == heldHandles[slotIdx]
            bNew := FALSE


PRI badHandle(kindIdx) : handle
' Give a handle outside the range of handles.

' @param kindIdx - the kind of bad handle: BAD_NEGATIVE, BAD_AT_MAX or BAD_PAST_LAST
' @returns handle - the bad handle

    case kindIdx
        BAD_NEGATIVE: handle := BAD_HANDLE_VALUE
        BAD_AT_MAX: handle := flash.MAX_FILES_OPEN
        other: handle := utils.FIRST_HANDLE + flash.MAX_FILES_OPEN


PRI fillDataBuffer() | byteIdx
' Fill the data buffer with the pattern of the data files.

' Local Variables:
' @local byteIdx - number of the byte being filled

    repeat DATA_BYTES with byteIdx
        BYTE[@dataBuf][byteIdx] := dataByte(byteIdx)


PRI dataByte(offset) : byteValue
' Compute the byte the data files hold at an offset.

' @param offset - offset of the byte from the start of the file
' @returns byteValue - the byte at the offset

    byteValue := (DATA_BASE + offset) & BYTE_MASK


PRI dataLong(offset) : longValue | byteIdx
' Compute the LONG the data files hold at an offset, in the byte order the driver reads it.

' @param offset - offset of the first byte of the LONG from the start of the file
' @returns longValue - the four bytes from the offset, the first one lowest

' Local Variables:
' @local byteIdx - number of the byte of the LONG being added

    longValue := 0
    repeat LONG_SIZE with byteIdx
        longValue |= dataByte(offset + byteIdx) << (byteIdx * BYTE_BITS)


PRI callHandleMethod(methodIdx, handle) : returned
' Make one of the handle calls with a handle and arguments that are valid for it.

' @param methodIdx - number of the handle call, one of the HM_ values
' @param handle - the handle to pass
' @returns returned - what the call returned

    case methodIdx
        HM_FLUSH: returned := flash.flush(handle)
        HM_CLOSE: returned := flash.close(handle)
        HM_SEEK: returned := flash.seek(handle, 0, flash.SK_FILE_START)
        HM_WRITE: returned := flash.write(handle, @oneByte, BYTE_SIZE)
        HM_WR_BYTE: returned := flash.wr_byte(handle, BYTE_TEST_VALUE)
        HM_WR_WORD: returned := flash.wr_word(handle, WORD_TEST_VALUE)
        HM_WR_LONG: returned := flash.wr_long(handle, LONG_TEST_VALUE)
        HM_WR_STR: returned := flash.wr_str(handle, @writeText)
        HM_READ: returned := flash.read(handle, @readBuf, BYTE_SIZE)
        HM_RD_BYTE: returned := flash.rd_byte(handle)
        HM_RD_WORD: returned := flash.rd_word(handle)
        HM_RD_LONG: returned := flash.rd_long(handle)
        HM_RD_STR: returned := flash.rd_str(handle, @stringBuf, STRING_BUF_BYTES)
        other: returned := flash.file_size_for_handle(handle)


PRI expectedReturn(methodIdx, failureCode) : expected
' Give what a handle call returns when it fails with a code: the calls that return a count or a long return 0.

' @param methodIdx - number of the handle call, one of the HM_ values
' @param failureCode - the code the call fails with
' @returns expected - the value the call returns

    case methodIdx
        HM_READ, HM_RD_LONG, HM_RD_STR: expected := NO_BYTES
        other: expected := failureCode


PRI handleMethodName(methodIdx) : pName
' Give the name of a handle call.

' @param methodIdx - number of the handle call, one of the HM_ values
' @returns pName - address of zstring with the name

    case methodIdx
        HM_FLUSH: pName := @"flush()"
        HM_CLOSE: pName := @"close()"
        HM_SEEK: pName := @"seek()"
        HM_WRITE: pName := @"write()"
        HM_WR_BYTE: pName := @"wr_byte()"
        HM_WR_WORD: pName := @"wr_word()"
        HM_WR_LONG: pName := @"wr_long()"
        HM_WR_STR: pName := @"wr_str()"
        HM_READ: pName := @"read()"
        HM_RD_BYTE: pName := @"rd_byte()"
        HM_RD_WORD: pName := @"rd_word()"
        HM_RD_LONG: pName := @"rd_long()"
        HM_RD_STR: pName := @"rd_str()"
        other: pName := @"file_size_for_handle()"


PRI firstMismatch(pFirst, pSecond, byteCount) : mismatchIdx | byteIdx
' Find the first byte at which two buffers differ.

' @param pFirst - address of the first buffer
' @param pSecond - address of the second buffer
' @param byteCount - number of bytes to compare
' @returns mismatchIdx - offset of the first differing byte, or NO_MISMATCH when the buffers agree

' Local Variables:
' @local byteIdx - number of the byte being compared

    mismatchIdx := NO_MISMATCH
    repeat byteCount with byteIdx
        if BYTE[pFirst][byteIdx] <> BYTE[pSecond][byteIdx]
            mismatchIdx := byteIdx
            quit


