'' =================================================================================================
''
''   File....... RT_error_paths_tests.spin2
''   Purpose.... This object exercises the error() contract of the flash filesystem: after every call
''               error() holds SUCCESS when the call succeeded and the call's own code when it failed,
''               the accessors error(), string_for_error(), null() and mounted() leave a pending code
''               alone, and a handle outside the range, a handle not open and a handle closed twice
''               are refused without touching any state of another handle
''   Author..... Stephen M Moraco
''               -- see below for terms of use
''   E-mail.....stephen@ironsheep.biz
''   Started.... NOV 2026
''   Updated.... 24 NOV 2026
''
'' =================================================================================================

{ Every expectation is the contract, never what the driver happens to do.  A call that fails returns
  its error code, or 0 when it returns a count or a long, and leaves the same code in error() for the
  calling cog.  A call that succeeds leaves SUCCESS in error(), so each success case first leaves a
  failure code pending.  A call with a handle that is not an open handle fails with E_BAD_HANDLE.

  The cases that can damage the driver's state run last: file_size_for_handle() with a handle outside
  the range, and opening every handle after a handle was closed twice.  The last case reads the
  handle status bytes, and the bytes around them, through a driver test hook before and after the
  open that has no handle left, and the two dumps must be the same.  Every case that changes the
  handle count is followed by an unmount and a mount, which give every handle back.
}

CON

     _CLKFREQ        = 320_000_000

{
    ' debug via serial to RPi (using RPi gateway pins)
    '  USES LED1 (56) and LED2 (57) pins
    DEBUG_PIN_TX = 57           ' GRY GPIO 10
    DEBUG_PIN_RX = 56           ' WHT GPIO 8 (gnd is BLK GPIO 6)
    DEBUG_WINDOWS_OFF = -1      ' no debug windows showing
    DEBUG_BAUD = 2_000_000      ' comms at 2Mbit
'}

OBJ
    flash : "flash_fs"
    utils : "RT_utilities"

CON ' ---- Test Geometry ----

    MIN_HANDLES_NEEDED = 2                              ' handles the open-file cases hold at one time
    HANDLE_SLOTS = flash.MAX_FILES_OPEN #> 1            ' handles the cases record as held
    DATA_BYTES = 64                                     ' bytes of the data file, each the offset plus DATA_BASE
    DATA_BASE = 1                                       ' value of the first byte of the data file
    TINY_BYTES = 3                                      ' bytes of the tiny file: one WORD and a byte no WORD can use
    CREATE_BYTES = 100                                  ' bytes of the file create_file() makes
    CREATE_FILL = $5A                                   ' fill value of the file create_file() makes
    CIRC_LIMIT_BYTES = 1000                             ' limit a circular handle is opened with
    ZERO_LENGTH = 0                                     ' a file length that no file can have
    NEGATIVE_LENGTH = -1                                ' a file length below zero
    NEGATIVE_COUNT = -1                                 ' a transfer count below zero
    BEFORE_FIRST_BYTE = -1                              ' a file position before the first byte
    WHENCE_PAST_LAST = flash.SK_CURRENT_POSN + 1        ' the first seek whence above the valid ones
    NO_BYTES = 0                                        ' a transfer count of zero, and the return of a call that moved nothing
    UNTOUCHED_BYTE = $C3                                ' value set in the first byte of a buffer a call must leave alone
    TAIL_TEXT_BYTES = 4                                 ' bytes of the last string of the string file, which has no terminator
    TRUNCATE_BUF_BYTES = 4                              ' string buffer size that holds less than the string
    STRING_BUF_BYTES = 16                               ' string buffer size that holds every string of the string file
    DIR_PAD_BYTES = 1                                   ' bytes the directory name buffer holds beyond the name field
    DIR_CALL_LIMIT = 200                                ' directory() calls made before the walk gives up
    GUARD_BYTES = 8                                     ' bytes of the handle status dump on each side of the array
    DUMP_BYTES = (GUARD_BYTES * 2) + flash.MAX_FILES_OPEN ' bytes the handle status dump holds
    WORKER_STACK_LONGS = 256                            ' stack of the cog that calls write()
    WORKER_WAIT_MS = 10_000                             ' time the worker cog has to finish
    WORKER_POLL_MS = 10                                 ' pause between looks at the worker's flag
    NAME_DIGIT_RADIX = 10                               ' radix of the numbers in the names of the files that fill the handles
    FILL_TENS_OFFSET = 4                                ' offset of the tens digit in the fill file name
    FILL_ONES_OFFSET = 5                                ' offset of the ones digit in the fill file name

CON ' ---- Test Data ----

    BYTE_SIZE = 1                                       ' bytes in a BYTE
    WORD_SIZE = 2                                       ' bytes in a WORD
    LONG_SIZE = 4                                       ' bytes in a LONG
    TERMINATOR_BYTES = 1                                ' bytes in the terminator of a zstring
    BYTE_BITS = 8                                       ' bits in a byte
    BYTE_MASK = $FF                                     ' keeps a value to one byte
    BAD_HANDLE_VALUE = -1                               ' a handle below every handle
    BYTE_TEST_VALUE = $A5                               ' BYTE the write cases store
    WORD_TEST_VALUE = $1234                             ' WORD the write cases store
    LONG_TEST_VALUE = $1234_5678                        ' LONG the write cases store
    TINY_FIRST = $11                                    ' bytes of the tiny file
    TINY_SECOND = $22
    TINY_THIRD = $33
    TINY_WORD = TINY_FIRST | (TINY_SECOND << BYTE_BITS) ' the WORD the first two bytes of the tiny file make
    READ_SPAN = BYTE_SIZE + WORD_SIZE + LONG_SIZE       ' bytes the read cases consume in order
    NO_MISMATCH = -1                                    ' firstMismatch() result when the buffers agree
    WORKER_BYTE = $5A                                   ' byte the worker cog tries to write

    ' mode values the driver does not accept, packed the way the driver packs "r+": the first letter in the low byte
    MODE_X = "x"                                        ' one letter that is no mode
    MODE_READ_WRITE = "r" | ("w" << BYTE_BITS)          ' two letters that are no mode
    MODE_APPEND_EXTENDED = "a" | ("+" << BYTE_BITS)     ' a mode of C that the driver does not have

CON ' ---- Handle Methods and Bad Handles ----

    ' The calls that take a handle, in the order callHandleMethod() dispatches them:
    '  HM_FLUSH, HM_CLOSE, HM_SEEK                       - handle control calls
    '  HM_WRITE, HM_WR_BYTE, HM_WR_WORD, HM_WR_LONG, HM_WR_STR - the write calls
    '  HM_READ, HM_RD_BYTE, HM_RD_WORD, HM_RD_LONG, HM_RD_STR - the read calls
    '  HM_FILE_SIZE_FOR_HANDLE                           - the size call
    '  HM_COUNT                                          - the number of calls
    #0, HM_FLUSH, HM_CLOSE, HM_SEEK, HM_WRITE, HM_WR_BYTE, HM_WR_WORD, HM_WR_LONG, HM_WR_STR, HM_READ, HM_RD_BYTE, HM_RD_WORD, HM_RD_LONG, HM_RD_STR, HM_FILE_SIZE_FOR_HANDLE, HM_COUNT

    ' The handles that are outside the range of handles:
    '  BAD_NEGATIVE   - below every handle
    '  BAD_AT_MAX     - the number of handles, whatever the first handle is
    '  BAD_PAST_LAST  - the first handle plus the number of handles, one past the last handle
    '  BAD_HANDLE_KINDS - the number of kinds
    #0, BAD_NEGATIVE, BAD_AT_MAX, BAD_PAST_LAST, BAD_HANDLE_KINDS

DAT ' ---- Counters, Flags and Worker Stack ----

workDone        LONG    FALSE                           ' set by the worker cog when it has recorded every result
workWriteHandle LONG    0                               ' write handle the worker calls write() with
workReadHandle  LONG    0                               ' read handle the worker calls write() with
workZeroResult  LONG    0                               ' what write() returned for a count of zero
workZeroError   LONG    0                               ' error() of the worker cog after it
workBadResult   LONG    0                               ' what write() returned for a handle that is no handle
workBadError    LONG    0                               ' error() of the worker cog after it
workModeResult  LONG    0                               ' what write() returned for a read handle
workModeError   LONG    0                               ' error() of the worker cog after it
directoryId     LONG    0                               ' block ID directory() continues from
directorySize   LONG    0                               ' size of the file directory() found
heldHandles     LONG    0[HANDLE_SLOTS]                 ' handles the fill cases hold
workStack       LONG    0[WORKER_STACK_LONGS]           ' stack of the worker cog

DAT ' ---- Files and Buffers ----

dataFile        BYTE    "err_data.bin", 0               ' a file of DATA_BYTES bytes
otherFile       BYTE    "err_other.bin", 0              ' a second file of DATA_BYTES bytes
tinyFile        BYTE    "err_tiny.bin", 0               ' a file of TINY_BYTES bytes
stringFile      BYTE    "err_string.bin", 0             ' a file of three strings, the last without its terminator
newFile         BYTE    "err_new.bin", 0                ' a name no file keeps
missingFile     BYTE    "err_missing.bin", 0            ' a name no file has
tempFile        BYTE    "err_temp.bin", 0               ' a file the rename case moves
renamedFile     BYTE    "err_renamed.bin", 0            ' the name the rename case moves it to
createdFile     BYTE    "err_created.bin", 0            ' the file create_file() makes
writtenFile     BYTE    "err_written.bin", 0            ' the file the write calls make
zeroLenFile     BYTE    "err_zero.bin", 0               ' a name create_file() is given with a length of zero
negLenFile      BYTE    "err_negative.bin", 0           ' a name create_file() is given with a length below zero
extraFile       BYTE    "err_extra.bin", 0              ' the name opened when every handle is in use
fillFile        BYTE    "fill00.bin", 0                 ' template of the names of the files that fill the handles
writeText       BYTE    "text", 0                       ' the string the write cases store

tinyContent     BYTE    TINY_FIRST, TINY_SECOND, TINY_THIRD

' the string file holds the zstrings in this order, the last one without a terminator
stringContent
firstText       BYTE    "OK", 0
secondText      BYTE    "LONGSTRING", 0
thirdText       BYTE    "tail"
stringEnd

oneByte         BYTE    0                               ' a byte for the calls that move one byte
dataBuf         BYTE    0[DATA_BYTES]                   ' what the data files hold
readBuf         BYTE    0[DATA_BYTES]                   ' what a read call fills
stringBuf       BYTE    0[STRING_BUF_BYTES]             ' what rd_str() fills
dirName         BYTE    0[flash.FILENAME_SIZE + DIR_PAD_BYTES] ' the name directory() reports
dumpBefore      BYTE    0[DUMP_BYTES]                   ' handle status dump taken before the open that has no handle
dumpAfter       BYTE    0[DUMP_BYTES]                   ' handle status dump taken after it


PUB go() | status, pFailedCall
'' Run every error() contract test, then show the result.
''

' Local Variables:
' @local status - status of the format and mount that start the run
' @local pFailedCall - address of the name of the call that failed

    pFailedCall := @"format()"
    status := flash.format()      ' Comment out this line to not erase all files
    if status == flash.SUCCESS
        pFailedCall := @"mount()"
        status := flash.mount()

    if status == flash.SUCCESS
        utils.checkDriverInstance(flash.MAX_FILES_OPEN)

        utils.showChipAndDriverVersion()
        utils.setCheckCountPerTest(1)                   ' each check of a case is shown on its own

        testHandlesAvailable()
        testNotMounted()
        testSuccessPaths()
        testExemptAccessors()
        testOpenFailures()
        testCircularOpenFailures()
        testFileOperationFailures()
        testModeMismatches()
        testReadResults()
        testStringReads()
        testSeekCodes()
        testWriteFromOtherCog()
        testTransferCounts()
        testCreateFileLength()
        testBadHandles()
        testNeverOpenedHandle()
        testFileSizeBadHandles()
        testPoolAfterDoubleClose()
    else
        utils.showError(pFailedCall, status)
        utils.startTest(@"format() and mount()")        ' a filesystem that did not mount is a failed run
        utils.evaluateResultNegError(status, flash.SUCCESS)

    debug("* Test Complete")
    utils.ShowTestResult(@"RT_error_paths_tests")


PRI testHandlesAvailable() | bEnoughHandles
' Check that the driver has the handles the open-file cases hold at one time.

' Local Variables:
' @local bEnoughHandles - TRUE when the driver has at least MIN_HANDLES_NEEDED handles

    utils.startTestGroup(@"handles available to the cases")
    utils.startTest(@"MAX_FILES_OPEN covers the files the open-file cases hold at one time")
    bEnoughHandles := flash.MAX_FILES_OPEN >= MIN_HANDLES_NEEDED
    utils.evaluateSingleValue(bEnoughHandles, @"MAX_FILES_OPEN is enough", TRUE)


PRI testNotMounted()
' Call every method that checks the mount first while the filesystem is not mounted: each one reports E_NOT_MOUNTED.

    utils.startTestGroup(@"calls while the filesystem is not mounted")
    utils.startTest(@"unmount() of a mounted filesystem")
    checkStatus(flash.unmount(), flash.SUCCESS, flash.SUCCESS)

    testNotMountedFiles()
    testNotMountedHandles()
    testNotMountedQueries()

    utils.startTest(@"can_mount() while not mounted")
    flash.unmount()                                     ' leaves E_NOT_MOUNTED pending
    flash.can_mount()
    utils.evaluateSubStatus(flash.error(), @"error() after can_mount()", flash.SUCCESS)

    utils.startTest(@"mount() after an unmount")
    flash.unmount()                                     ' leaves E_NOT_MOUNTED pending
    checkStatus(flash.mount(), flash.SUCCESS, flash.SUCCESS)


PRI testNotMountedFiles()
' The calls that take a file name, made while the filesystem is not mounted.

    utils.startTest(@"open() before mount")
    checkStatus(flash.open(@dataFile, flash.FILEMODE_READ), flash.E_NOT_MOUNTED, flash.E_NOT_MOUNTED)

    utils.startTest(@"open_circular() before mount")
    checkStatus(flash.open_circular(@dataFile, flash.FILEMODE_READ, CIRC_LIMIT_BYTES), flash.E_NOT_MOUNTED, flash.E_NOT_MOUNTED)

    utils.startTest(@"rename() before mount")
    checkStatus(flash.rename(@dataFile, @tempFile), flash.E_NOT_MOUNTED, flash.E_NOT_MOUNTED)

    utils.startTest(@"delete() before mount")
    checkStatus(flash.delete(@dataFile), flash.E_NOT_MOUNTED, flash.E_NOT_MOUNTED)

    utils.startTest(@"create_file() before mount")
    checkStatus(flash.create_file(@dataFile, CREATE_FILL, CREATE_BYTES), flash.E_NOT_MOUNTED, flash.E_NOT_MOUNTED)

    utils.startTest(@"exists() before mount")
    checkValue(flash.exists(@dataFile), FALSE, flash.E_NOT_MOUNTED)

    utils.startTest(@"file_size() before mount")
    checkStatus(flash.file_size(@dataFile), flash.E_NOT_MOUNTED, flash.E_NOT_MOUNTED)

    utils.startTest(@"file_size_unused() before mount")
    checkStatus(flash.file_size_unused(@dataFile), flash.E_NOT_MOUNTED, flash.E_NOT_MOUNTED)


PRI testNotMountedHandles() | methodIdx
' The calls that take a handle, made while the filesystem is not mounted: the mount is checked before the handle.

' Local Variables:
' @local methodIdx - number of the handle call being made

    repeat HM_COUNT with methodIdx
        utils.startTest(handleMethodName(methodIdx))
        checkValue(callHandleMethod(methodIdx, utils.FIRST_HANDLE), expectedReturn(methodIdx, flash.E_NOT_MOUNTED), flash.E_NOT_MOUNTED)


PRI testNotMountedQueries() | pending, errCode, serialHigh, serialLow, usedBlocks, freeBlocks, fileCount, bMounted, versionNumber
' The calls that take no name and no handle, made while the filesystem is not mounted.

' Local Variables:
' @local pending - code the call that set the pending error returned
' @local errCode - error() after the call
' @local serialHigh - high long of the serial number serial_number() returned
' @local serialLow - low long of the serial number serial_number() returned
' @local usedBlocks - first value stats() returned
' @local freeBlocks - second value stats() returned
' @local fileCount - third value stats() returned
' @local bMounted - what mounted() returned
' @local versionNumber - what version() returned

    utils.startTest(@"unmount() when not mounted")
    checkStatus(flash.unmount(), flash.E_NOT_MOUNTED, flash.E_NOT_MOUNTED)

    utils.startTest(@"serial_number() before mount")
    serialHigh, serialLow := flash.serial_number()
    errCode := flash.error()
    utils.evaluateSubValue(serialHigh, @"high long of the serial number", 0)
    utils.evaluateSubValue(serialLow, @"low long of the serial number", 0)
    utils.evaluateSubStatus(errCode, @"error() after serial_number()", flash.E_NOT_MOUNTED)

    utils.startTest(@"directory() before mount")
    directoryId := 0
    checkStatus(flash.directory(@directoryId, @dirName, @directorySize), flash.E_NOT_MOUNTED, flash.E_NOT_MOUNTED)

    utils.startTest(@"stats() before mount")
    usedBlocks, freeBlocks, fileCount := flash.stats()
    errCode := flash.error()
    utils.evaluateSubStatus(usedBlocks, @"used blocks", flash.E_NOT_MOUNTED)
    utils.evaluateSubValue(freeBlocks, @"free blocks", 0)
    utils.evaluateSubValue(fileCount, @"file count", 0)
    utils.evaluateSubStatus(errCode, @"error() after stats()", flash.E_NOT_MOUNTED)

    utils.startTest(@"mounted() leaves the pending E_NOT_MOUNTED alone")
    pending := flash.unmount()
    bMounted := flash.mounted()
    errCode := flash.error()
    utils.evaluateSubValue(bMounted, @"mounted()", FALSE)
    utils.evaluateSubStatus(errCode, @"error() after mounted()", pending)

    utils.startTest(@"version() works while not mounted and leaves SUCCESS")
    flash.unmount()                                     ' leaves E_NOT_MOUNTED pending
    versionNumber := flash.version()
    errCode := flash.error()
    utils.evaluateSubValue(versionNumber, @"version()", flash.LIB_VERSION)
    utils.evaluateSubStatus(errCode, @"error() after version()", flash.SUCCESS)


PRI testSuccessPaths()
' Check that error() holds SUCCESS after every call that succeeds, each made with a failure code pending.

    utils.startTestGroup(@"error() after calls that succeed")
    formatFresh(@"format() of a mounted filesystem")
    fillDataBuffer()
    createFile(@"set up the data file", @dataFile, @dataBuf, DATA_BYTES)
    createFile(@"set up the second file", @otherFile, @dataBuf, DATA_BYTES)
    createFile(@"set up the tiny file", @tinyFile, @tinyContent, TINY_BYTES)
    createFile(@"set up the string file", @stringFile, @stringContent, @stringEnd - @stringContent)

    testQuerySuccess()
    testOpenModesSucceed()
    testReadSuccess()
    testWriteSuccess()
    testDirectoryAndStats()
    testRenameDeleteCreateSuccess()


PRI testQuerySuccess() | versionNumber, errCode
' The calls that only look at the filesystem, made with a failure code pending.

' Local Variables:
' @local versionNumber - what version() returned
' @local errCode - error() after the call

    utils.startTest(@"version() clears a pending failure code")
    setPendingError()
    versionNumber := flash.version()
    errCode := flash.error()
    utils.evaluateSubValue(versionNumber, @"version()", flash.LIB_VERSION)
    utils.evaluateSubStatus(errCode, @"error() after version()", flash.SUCCESS)

    utils.startTest(@"serial_number() clears a pending failure code")
    setPendingError()
    flash.serial_number()
    utils.evaluateSubStatus(flash.error(), @"error() after serial_number()", flash.SUCCESS)

    utils.startTest(@"mount() of a mounted filesystem clears a pending failure code")
    setPendingError()
    checkStatus(flash.mount(), flash.SUCCESS, flash.SUCCESS)

    utils.startTest(@"can_mount() of a mounted filesystem clears a pending failure code")
    setPendingError()
    flash.can_mount()
    utils.evaluateSubStatus(flash.error(), @"error() after can_mount()", flash.SUCCESS)

    utils.startTest(@"exists() of a file that exists")
    setPendingError()
    checkValue(flash.exists(@dataFile), TRUE, flash.SUCCESS)

    utils.startTest(@"exists() of a file that does not exist is an answer, not an error")
    setPendingError()
    checkValue(flash.exists(@missingFile), FALSE, flash.SUCCESS)

    utils.startTest(@"file_size() of a file")
    setPendingError()
    checkValue(flash.file_size(@dataFile), DATA_BYTES, flash.SUCCESS)

    utils.startTest(@"file_size_unused() of a file")
    setPendingError()
    checkValue(flash.file_size_unused(@dataFile), flash.BYTES_IN_HEAD_BLOCK - DATA_BYTES, flash.SUCCESS)


PRI testOpenModesSucceed()
' Open and close a handle in every mode the driver has, each with a failure code pending.

    modeSucceeds(@"open(,r) of an existing file", @dataFile, flash.FILEMODE_READ, 0)
    modeSucceeds(@"open(,w) of a new file", @newFile, flash.FILEMODE_WRITE, 0)
    modeSucceeds(@"open(,a) of an existing file", @otherFile, flash.FILEMODE_APPEND, 0)
    modeSucceeds(@"open(,a) of a new file", @newFile, flash.FILEMODE_APPEND, 0)
    modeSucceeds(@"open(,r+) of an existing file", @otherFile, flash.FILEMODE_READ_EXTENDED, 0)
    modeSucceeds(@"open(,w+) of a new file", @newFile, flash.FILEMODE_WRITE_EXTENDED, 0)
    modeSucceeds(@"open_circular(,r) of an existing file", @dataFile, flash.FILEMODE_READ, CIRC_LIMIT_BYTES)
    modeSucceeds(@"open_circular(,a) of a new file", @newFile, flash.FILEMODE_APPEND, CIRC_LIMIT_BYTES)


PRI testReadSuccess() | handle
' The read calls and the calls that move or measure a handle, on a read handle, each with a failure code pending.

' Local Variables:
' @local handle - handle of the data file

    handle := openFor(@dataFile, flash.FILEMODE_READ, @"open(,r) the data file for the read calls")

    utils.startTest(@"read() of every byte of the file")
    setPendingError()
    checkValue(flash.read(handle, @readBuf, DATA_BYTES), DATA_BYTES, flash.SUCCESS)

    utils.startTest(@"seek() to the first byte")
    setPendingError()
    checkValue(flash.seek(handle, 0, flash.SK_FILE_START), 0, flash.SUCCESS)

    utils.startTest(@"rd_byte() of the first byte")
    setPendingError()
    checkValue(flash.rd_byte(handle), dataByte(0), flash.SUCCESS)

    utils.startTest(@"rd_word() of the next two bytes")
    setPendingError()
    checkValue(flash.rd_word(handle), dataByte(BYTE_SIZE) | (dataByte(BYTE_SIZE + 1) << BYTE_BITS), flash.SUCCESS)

    utils.startTest(@"rd_long() of the next four bytes")
    setPendingError()
    checkValue(flash.rd_long(handle), dataLong(BYTE_SIZE + WORD_SIZE), flash.SUCCESS)

    utils.startTest(@"seek() relative to the current position")
    setPendingError()
    checkValue(flash.seek(handle, -READ_SPAN, flash.SK_CURRENT_POSN), 0, flash.SUCCESS)

    utils.startTest(@"file_size_for_handle() of an open file")
    setPendingError()
    checkValue(flash.file_size_for_handle(handle), DATA_BYTES, flash.SUCCESS)

    utils.startTest(@"close() of the read handle")
    setPendingError()
    closeSub(handle)


PRI testWriteSuccess() | handle, expectedBytes
' The write calls, flush() and close() on a new file, each with a failure code pending.

' Local Variables:
' @local handle - handle of the file being written
' @local expectedBytes - bytes the file holds once every write call has stored its data

    expectedBytes := DATA_BYTES + BYTE_SIZE + WORD_SIZE + LONG_SIZE + strsize(@writeText) + TERMINATOR_BYTES
    handle := openFor(@writtenFile, flash.FILEMODE_WRITE, @"open(,w) a new file for the write calls")

    utils.startTest(@"write() of a buffer")
    setPendingError()
    checkValue(flash.write(handle, @dataBuf, DATA_BYTES), DATA_BYTES, flash.SUCCESS)

    utils.startTest(@"wr_byte() of a byte")
    setPendingError()
    checkStatus(flash.wr_byte(handle, BYTE_TEST_VALUE), flash.SUCCESS, flash.SUCCESS)

    utils.startTest(@"wr_word() of a WORD")
    setPendingError()
    checkStatus(flash.wr_word(handle, WORD_TEST_VALUE), flash.SUCCESS, flash.SUCCESS)

    utils.startTest(@"wr_long() of a LONG")
    setPendingError()
    checkStatus(flash.wr_long(handle, LONG_TEST_VALUE), flash.SUCCESS, flash.SUCCESS)

    utils.startTest(@"wr_str() of a string")
    setPendingError()
    checkStatus(flash.wr_str(handle, @writeText), flash.SUCCESS, flash.SUCCESS)

    utils.startTest(@"flush() of a write handle")
    setPendingError()
    checkStatus(flash.flush(handle), flash.SUCCESS, flash.SUCCESS)

    utils.startTest(@"close() of the write handle")
    setPendingError()
    closeSub(handle)

    utils.startTest(@"the written file holds every byte the write calls stored")
    checkValue(flash.file_size(@writtenFile), expectedBytes, flash.SUCCESS)


PRI testDirectoryAndStats() | status, errCode, usedBlocks, freeBlocks, fileCount
' The calls that list the filesystem, each with a failure code pending.

' Local Variables:
' @local status - status of the last directory() call
' @local errCode - error() after the call
' @local usedBlocks - first value stats() returned
' @local freeBlocks - second value stats() returned
' @local fileCount - third value stats() returned

    utils.startTest(@"directory() finds a file")
    setPendingError()
    directoryId := 0
    checkStatus(flash.directory(@directoryId, @dirName, @directorySize), flash.SUCCESS, flash.SUCCESS)

    utils.startTest(@"directory() walks to the end of the list")
    setPendingError()
    directoryId := 0
    status := flash.SUCCESS
    repeat DIR_CALL_LIMIT
        status := flash.directory(@directoryId, @dirName, @directorySize)
        if status <> flash.SUCCESS or strsize(@dirName) == 0
            quit
    errCode := flash.error()
    utils.evaluateSubStatus(status, @"directory() at the end of the list", flash.SUCCESS)
    utils.evaluateSubValue(strsize(@dirName), @"length of the name at the end of the list", 0)
    utils.evaluateSubStatus(errCode, @"error() after directory()", flash.SUCCESS)

    utils.startTest(@"stats() of the filesystem")
    setPendingError()
    usedBlocks, freeBlocks, fileCount := flash.stats()
    errCode := flash.error()
    utils.evaluateSubValue(usedBlocks + freeBlocks, @"used plus free blocks", flash.BLOCKS)
    utils.evaluateSubValue(fileCount > 0, @"at least one file", TRUE)
    utils.evaluateSubStatus(errCode, @"error() after stats()", flash.SUCCESS)


PRI testRenameDeleteCreateSuccess()
' Rename, delete and create a file, each with a failure code pending.

    createFile(@"set up the file to rename", @tempFile, @dataBuf, DATA_BYTES)

    utils.startTest(@"rename() of a file to a new name")
    setPendingError()
    checkStatus(flash.rename(@tempFile, @renamedFile), flash.SUCCESS, flash.SUCCESS)

    utils.startTest(@"the old name is gone and the new name is there")
    checkValue(flash.exists(@tempFile), FALSE, flash.SUCCESS)
    utils.evaluateSubValue(flash.exists(@renamedFile), @"exists() of the new name", TRUE)

    utils.startTest(@"delete() of a file")
    setPendingError()
    checkStatus(flash.delete(@renamedFile), flash.SUCCESS, flash.SUCCESS)

    utils.startTest(@"the deleted file is gone")
    checkValue(flash.exists(@renamedFile), FALSE, flash.SUCCESS)

    utils.startTest(@"create_file() of a new file")
    setPendingError()
    checkStatus(flash.create_file(@createdFile, CREATE_FILL, CREATE_BYTES), flash.SUCCESS, flash.SUCCESS)

    utils.startTest(@"the created file has the length it was given")
    checkValue(flash.file_size(@createdFile), CREATE_BYTES, flash.SUCCESS)


PRI testExemptAccessors() | pending, pText, bMounted
' The accessors that never change the code a failing call left: error(), string_for_error(), null() and mounted().

' Local Variables:
' @local pending - code the failing call left in error()
' @local pText - address of the text string_for_error() returned
' @local bMounted - what mounted() returned

    utils.startTestGroup(@"accessors that leave a pending code alone")

    utils.startTest(@"error() reports the pending code every time it is called")
    pending := setPendingError()
    utils.evaluateSubStatus(flash.error(), @"first error()", pending)
    utils.evaluateSubStatus(flash.error(), @"second error()", pending)

    utils.startTest(@"string_for_error() leaves the pending code alone")
    pending := setPendingError()
    pText := flash.string_for_error(flash.E_BAD_HANDLE)
    utils.evaluateSubValue(pText <> 0, @"string_for_error() returned a text", TRUE)
    utils.evaluateSubStatus(flash.error(), @"error() after string_for_error()", pending)

    utils.startTest(@"null() leaves the pending code alone")
    pending := setPendingError()
    flash.null()
    utils.evaluateSubStatus(flash.error(), @"error() after null()", pending)

    utils.startTest(@"mounted() leaves the pending code alone")
    pending := setPendingError()
    bMounted := flash.mounted()
    utils.evaluateSubValue(bMounted, @"mounted()", TRUE)
    utils.evaluateSubStatus(flash.error(), @"error() after mounted()", pending)


PRI testOpenFailures() | handle
' Every way open() fails that needs no fault: a missing file, modes that do not exist, a file already open and no free handle.

' Local Variables:
' @local handle - handle of the file the open-file cases find open

    utils.startTestGroup(@"open() failures")

    utils.startTest(@"open(,r) of a file that does not exist")
    checkStatus(flash.open(@missingFile, flash.FILEMODE_READ), flash.E_FILE_NOT_FOUND, flash.E_FILE_NOT_FOUND)

    utils.startTest(@"open(,r+) of a file that does not exist")
    checkStatus(flash.open(@missingFile, flash.FILEMODE_READ_EXTENDED), flash.E_FILE_NOT_FOUND, flash.E_FILE_NOT_FOUND)

    utils.startTest(@"open() with a one-letter mode that is no mode")
    checkStatus(flash.open(@newFile, MODE_X), flash.E_FILE_MODE, flash.E_FILE_MODE)

    utils.startTest(@"open() with a two-letter mode that is no mode")
    checkStatus(flash.open(@newFile, MODE_READ_WRITE), flash.E_FILE_MODE, flash.E_FILE_MODE)

    utils.startTest(@"open() with the append-and-read mode of C")
    checkStatus(flash.open(@newFile, MODE_APPEND_EXTENDED), flash.E_FILE_MODE, flash.E_FILE_MODE)

    handle := openFor(@dataFile, flash.FILEMODE_READ, @"open(,r) a file the next calls find open")

    utils.startTest(@"open(,r) of a file that is open")
    checkStatus(flash.open(@dataFile, flash.FILEMODE_READ), flash.E_FILE_OPEN, flash.E_FILE_OPEN)

    utils.startTest(@"open(,w) of a file that is open")
    checkStatus(flash.open(@dataFile, flash.FILEMODE_WRITE), flash.E_FILE_OPEN, flash.E_FILE_OPEN)

    utils.startTest(@"open(,a) of a file that is open")
    checkStatus(flash.open(@dataFile, flash.FILEMODE_APPEND), flash.E_FILE_OPEN, flash.E_FILE_OPEN)

    utils.startTest(@"open(,r+) of a file that is open")
    checkStatus(flash.open(@dataFile, flash.FILEMODE_READ_EXTENDED), flash.E_FILE_OPEN, flash.E_FILE_OPEN)

    utils.startTest(@"open(,w+) of a file that is open")
    checkStatus(flash.open(@dataFile, flash.FILEMODE_WRITE_EXTENDED), flash.E_FILE_OPEN, flash.E_FILE_OPEN)

    utils.startTest(@"open_circular(,r) of a file that is open")
    checkStatus(flash.open_circular(@dataFile, flash.FILEMODE_READ, CIRC_LIMIT_BYTES), flash.E_FILE_OPEN, flash.E_FILE_OPEN)

    utils.startTest(@"open_circular(,a) of a file that is open")
    checkStatus(flash.open_circular(@dataFile, flash.FILEMODE_APPEND, CIRC_LIMIT_BYTES), flash.E_FILE_OPEN, flash.E_FILE_OPEN)

    utils.startTest(@"rename() of a file that is open")
    checkStatus(flash.rename(@dataFile, @tempFile), flash.E_FILE_OPEN, flash.E_FILE_OPEN)

    utils.startTest(@"rename() to the name of a file that is open")
    checkStatus(flash.rename(@otherFile, @dataFile), flash.E_FILE_OPEN, flash.E_FILE_OPEN)

    utils.startTest(@"delete() of a file that is open")
    checkStatus(flash.delete(@dataFile), flash.E_FILE_OPEN, flash.E_FILE_OPEN)

    utils.startTest(@"create_file() of a file that is open")
    checkStatus(flash.create_file(@dataFile, CREATE_FILL, CREATE_BYTES), flash.E_FILE_OPEN, flash.E_FILE_OPEN)

    utils.startTest(@"close() of the file the cases found open")
    closeSub(handle)

    openAllHandles()

    utils.startTest(@"open() with every handle in use")
    checkStatus(flash.open(@dataFile, flash.FILEMODE_READ), flash.E_NO_HANDLE, flash.E_NO_HANDLE)

    utils.startTest(@"open_circular() with every handle in use")
    checkStatus(flash.open_circular(@dataFile, flash.FILEMODE_READ, CIRC_LIMIT_BYTES), flash.E_NO_HANDLE, flash.E_NO_HANDLE)

    closeAllHandles()


PRI testCircularOpenFailures()
' Every way open_circular() fails that needs no fault and was not shown above: a bad length, a mode a circular file does not have, a missing file.

    utils.startTestGroup(@"open_circular() failures")

    utils.startTest(@"open_circular() with a length of zero")
    checkStatus(flash.open_circular(@newFile, flash.FILEMODE_APPEND, ZERO_LENGTH), flash.E_BAD_FILE_LENGTH, flash.E_BAD_FILE_LENGTH)

    utils.startTest(@"open_circular() with a length below zero")
    checkStatus(flash.open_circular(@newFile, flash.FILEMODE_APPEND, NEGATIVE_LENGTH), flash.E_BAD_FILE_LENGTH, flash.E_BAD_FILE_LENGTH)

    utils.startTest(@"open_circular(,w), a mode a circular file does not have")
    checkStatus(flash.open_circular(@newFile, flash.FILEMODE_WRITE, CIRC_LIMIT_BYTES), flash.E_FILE_MODE, flash.E_FILE_MODE)

    utils.startTest(@"open_circular(,r+), a mode a circular file does not have")
    checkStatus(flash.open_circular(@newFile, flash.FILEMODE_READ_EXTENDED, CIRC_LIMIT_BYTES), flash.E_FILE_MODE, flash.E_FILE_MODE)

    utils.startTest(@"open_circular() with a one-letter mode that is no mode")
    checkStatus(flash.open_circular(@newFile, MODE_X, CIRC_LIMIT_BYTES), flash.E_FILE_MODE, flash.E_FILE_MODE)

    utils.startTest(@"open_circular() with a two-letter mode that is no mode")
    checkStatus(flash.open_circular(@newFile, MODE_READ_WRITE, CIRC_LIMIT_BYTES), flash.E_FILE_MODE, flash.E_FILE_MODE)

    utils.startTest(@"open_circular() with the append-and-read mode of C")
    checkStatus(flash.open_circular(@newFile, MODE_APPEND_EXTENDED, CIRC_LIMIT_BYTES), flash.E_FILE_MODE, flash.E_FILE_MODE)

    utils.startTest(@"open_circular(,r) of a file that does not exist")
    checkStatus(flash.open_circular(@missingFile, flash.FILEMODE_READ, CIRC_LIMIT_BYTES), flash.E_FILE_NOT_FOUND, flash.E_FILE_NOT_FOUND)


PRI testFileOperationFailures()
' The calls that take a file name and find the wrong files: a name that is taken, a name that is missing.

    utils.startTestGroup(@"file name failures")

    utils.startTest(@"rename() onto the name of an existing file")
    checkStatus(flash.rename(@dataFile, @otherFile), flash.E_FILE_EXISTS, flash.E_FILE_EXISTS)

    utils.startTest(@"rename() of a file that does not exist")
    checkStatus(flash.rename(@missingFile, @newFile), flash.E_FILE_NOT_FOUND, flash.E_FILE_NOT_FOUND)

    utils.startTest(@"delete() of a file that does not exist")
    checkStatus(flash.delete(@missingFile), flash.E_FILE_NOT_FOUND, flash.E_FILE_NOT_FOUND)

    utils.startTest(@"create_file() of a name that is taken")
    checkStatus(flash.create_file(@otherFile, CREATE_FILL, CREATE_BYTES), flash.E_FILE_EXISTS, flash.E_FILE_EXISTS)

    utils.startTest(@"file_size() of a file that does not exist")
    checkStatus(flash.file_size(@missingFile), flash.E_FILE_NOT_FOUND, flash.E_FILE_NOT_FOUND)

    utils.startTest(@"file_size_unused() of a file that does not exist")
