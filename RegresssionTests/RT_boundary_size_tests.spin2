'' =================================================================================================
''
''   File....... RT_boundary_size_tests.spin2
''   Purpose.... This object exercises the file sizes at the edges of the block layout: one byte short
''               of, exactly at and one byte over the capacity of a head block and of a head block plus
''               one body block, each written and read back, made with create_file() and measured with
''               file_size_unused(), then a 64 KB and a 1 MB file each written and read back and
''               compared by CRC
''   Author..... Stephen M Moraco
''               -- see below for terms of use
''   E-mail.....stephen@ironsheep.biz
''   Started.... NOV 2026
''   Updated.... 24 NOV 2026
''
'' =================================================================================================

{ Every expectation is computed by the program from BYTES_IN_HEAD_BLOCK and BYTES_IN_BODY_BLOCK, never
  taken from the driver.  The layout of a size is found by filling blocks one after another until their
  capacity covers the size, which gives the blocks the file occupies and the bytes the last block leaves
  unused.  The number of blocks is also read from stats() before and after each file is made, so
  file_size_unused() is never the only witness of a layout.

  The sizes at the edges are written in one call, read back in one call and compared byte by byte.  A
  file that exactly fills a block must leave no unused byte, and a file one byte longer must start a
  new block that holds that one byte.

  The 64 KB and 1 MB files are streamed through one buffer in chunks.  The pattern of a chunk is
  computed from its offset in the file, so nothing but a CRC of each chunk is kept.  The CRCs of the
  chunks written and the CRCs of the chunks read back are each reduced to one CRC, and the two must
  be equal.
}

CON

     _CLKFREQ        = 320_000_000

{
    ' debug via serial to RPi (using RPi gateway pins)
    '  USES LED1 (56) and LED2 (57) pins
    DEBUG_PIN_TX = 57           ' GRY GPIO 10
    DEBUG_PIN_RX = 56           ' WHT GPIO 8 (gnd is BLK GPIO 6)
    DEBUG_WINDOWS_OFF = -1      ' no debug windows showing
    DEBUG_BAUD = 2_000_000      ' comms at 2Mbit
'}

OBJ
    flash : "flash_fs"
    utils : "RT_utilities"

CON ' ---- Block Edge Sizes ----

    ' the sizes at the edges of the block layout, in bytes:
    '  HEAD_FULL_BYTES  - what a head block holds
    '  TWO_FULL_BYTES   - what a head block and one body block hold
    HEAD_FULL_BYTES = flash.BYTES_IN_HEAD_BLOCK
    TWO_FULL_BYTES = flash.BYTES_IN_HEAD_BLOCK + flash.BYTES_IN_BODY_BLOCK
    ONE_BYTE = 1                                        ' bytes a size differs from a full block by, and bytes read past the end
    NO_BYTES = 0                                        ' bytes a read at the end of a file returns, and bytes a full block leaves unused
    LARGEST_EDGE_BYTES = TWO_FULL_BYTES + ONE_BYTE      ' the largest size of the edge cases

    ' the cases, one for each size:
    '  CASE_HEAD_BELOW - one byte short of a full head block
    '  CASE_HEAD_FULL  - exactly a full head block
    '  CASE_HEAD_ABOVE - one byte over a full head block
    '  CASE_TWO_BELOW  - one byte short of a full head block and body block
    '  CASE_TWO_FULL   - exactly a full head block and body block
    '  CASE_TWO_ABOVE  - one byte over a full head block and body block
    '  CASE_COUNT      - the number of cases
    #0, CASE_HEAD_BELOW, CASE_HEAD_FULL, CASE_HEAD_ABOVE, CASE_TWO_BELOW, CASE_TWO_FULL, CASE_TWO_ABOVE, CASE_COUNT

CON ' ---- Large Files ----

    KILOBYTE = 1024                                     ' bytes in a KB
    MEDIUM_BYTES = 64 * KILOBYTE                        ' size of the first round trip
    LARGE_BYTES = 1024 * KILOBYTE                       ' size of the second round trip, 1 MB
    CHUNK_BYTES = 4096                                  ' bytes moved by one write or read of a round trip
    MAX_DIGESTS = (LARGE_BYTES / CHUNK_BYTES) + 1       ' chunks of the largest round trip
    BYTES_PER_LONG = 4                                  ' bytes of one chunk CRC
    SPARE_BLOCKS = 8                                    ' free blocks a file needs beyond the blocks it occupies
    CRC_POLYNOMIAL = $EDB8_8320                         ' polynomial of every CRC the program computes

CON ' ---- Test Data ----

    ' the byte of a pattern is its offset, its 256-byte page number and the seed, so a block
    ' that lands in the wrong place or a stale page shows as a differing byte
    PATTERN_PAGE_SHIFT = 8                              ' 256-byte pages
    BYTE_MASK = $FF                                     ' keeps a pattern value to one byte
    SEED_EDGE = 3                                       ' pattern of the files written at the edges
    SEED_MEDIUM = 5                                     ' pattern of the 64 KB file
    SEED_LARGE = 7                                      ' pattern of the 1 MB file
    CREATE_FILL = $5A                                   ' fill value of the files made with create_file()
    POISON_BYTE = $A5                                   ' value read buffers are filled with before a read
    NO_MISMATCH = -1                                    ' firstMismatch() result when the buffers agree
    NAME_DIGIT_OFFSET = 5                               ' offset of the case digit in the name of an edge file
    TITLE_BYTES = 96                                    ' bytes the test title buffer holds

DAT ' ---- Files and Buffers ----

edgeWriteFile   BYTE    "bsz_w0.bin", 0                 ' template of the names of the files the edge cases write
edgeCreateFile  BYTE    "bsz_c0.bin", 0                 ' template of the names of the files the edge cases make with create_file()
mediumFile      BYTE    "bsz_64k.bin", 0                ' the 64 KB file
largeFile       BYTE    "bsz_1m.bin", 0                 ' the 1 MB file

oneByte         BYTE    0                               ' receives a single byte read
titleBuf        BYTE    0[TITLE_BYTES]                  ' the title of the test being started
modelBuf        BYTE    0[LARGEST_EDGE_BYTES]           ' what an edge file should hold
readBuf         BYTE    0[LARGEST_EDGE_BYTES]           ' what was read back from an edge file
chunkBuf        BYTE    0[CHUNK_BYTES]                  ' one chunk of a round trip

                ALIGNL
writeBlocks     LONG    0[CASE_COUNT]                   ' blocks stats() showed each edge file written with write() to occupy
createBlocks    LONG    0[CASE_COUNT]                   ' blocks stats() showed each edge file made with create_file() to occupy
writeDigests    LONG    0[MAX_DIGESTS]                  ' CRC of each chunk written
readDigests     LONG    0[MAX_DIGESTS]                  ' CRC of each chunk read back


PUB go() | status, pFailedCall
'' Run every boundary size test, then show the result.
''

' Local Variables:
' @local status - status of the format and mount that start the run
' @local pFailedCall - address of the name of the call that failed

    pFailedCall := @"format()"
    status := flash.format()      ' Comment out this line to not erase all files
    if status == flash.SUCCESS
        pFailedCall := @"mount()"
        status := flash.mount()

    if status == flash.SUCCESS
        utils.checkDriverInstance(flash.MAX_FILES_OPEN)

        utils.showChipAndDriverVersion()
        utils.setCheckCountPerTest(1)                   ' each check of a case is shown on its own

        testEdgeSizes()
        testNewBlockStarts()
        testRoundTrips()
    else
        utils.showError(pFailedCall, status)
        utils.startTest(@"format() and mount()")        ' a filesystem that did not mount is a failed run
        utils.evaluateResultNegError(status, flash.SUCCESS)

    debug("* Test Complete")
    utils.ShowTestResult(@"RT_boundary_size_tests")


PRI testEdgeSizes() | caseIdx
' Write, create and measure a file of each edge size.

' Local Variables:
' @local caseIdx - number of the size case being run

    utils.startTestGroup(@"files at the edges of the block layout")
    repeat CASE_COUNT with caseIdx
        writeReadCase(caseIdx)
        createFileCase(caseIdx)
        unusedCase(caseIdx)


PRI writeReadCase(caseIdx) | byteCount, blocksBefore, handle, status, writeCount
' Write a file of one edge size with write() in one call and read it back, as one test.

' @param caseIdx - the size case, one of the CASE_ values

' Local Variables:
' @local byteCount - bytes of the case
' @local blocksBefore - blocks in use before the file was written
' @local handle - handle of the file
' @local status - status of the open
' @local writeCount - what write() returned

    byteCount := caseBytes(caseIdx)
    setCaseName(@edgeWriteFile, caseIdx)
    utils.startTest(caseTitle(@"write() and read() of a file ", caseIdx))
    debug("  bytes: ", udec_(byteCount))

    fillPattern(@modelBuf, 0, byteCount, SEED_EDGE)
    blocksBefore := usedBlocks()
    handle, status := utils.openWaitOnHandle(@edgeWriteFile, flash.FILEMODE_WRITE)
    utils.evaluateSubStatus(status, @"open(,w)", flash.SUCCESS)
    if status == flash.SUCCESS
        writeCount := flash.write(handle, @modelBuf, byteCount)
        utils.evaluateSubValue(writeCount, @"write()", byteCount)
        status := utils.closeHandle(handle)
        utils.evaluateSubStatus(status, @"close()", flash.SUCCESS)

    LONG[@writeBlocks][caseIdx] := usedBlocks() - blocksBefore
    checkLayout(@edgeWriteFile, byteCount, LONG[@writeBlocks][caseIdx])
    checkReadBack(@edgeWriteFile, byteCount)


PRI createFileCase(caseIdx) | byteCount, blocksBefore, status
' Make a file of one edge size with create_file(), then read it back, as one test.

' @param caseIdx - the size case, one of the CASE_ values

' Local Variables:
' @local byteCount - bytes of the case
' @local blocksBefore - blocks in use before the file was made
' @local status - what create_file() returned

    byteCount := caseBytes(caseIdx)
    setCaseName(@edgeCreateFile, caseIdx)
    utils.startTest(caseTitle(@"create_file() of a file ", caseIdx))
    debug("  bytes: ", udec_(byteCount))

    bytefill(@modelBuf, CREATE_FILL, byteCount)
    blocksBefore := usedBlocks()
    status := flash.create_file(@edgeCreateFile, CREATE_FILL, byteCount)
    utils.evaluateSubStatus(status, @"create_file()", flash.SUCCESS)

    LONG[@createBlocks][caseIdx] := usedBlocks() - blocksBefore
    checkLayout(@edgeCreateFile, byteCount, LONG[@createBlocks][caseIdx])
    checkReadBack(@edgeCreateFile, byteCount)


PRI unusedCase(caseIdx) | byteCount, expectedUnused, bFillsBlock
' Check file_size_unused() of the two files of one edge size against the unused bytes the layout leaves, as one test.

' @param caseIdx - the size case, one of the CASE_ values

' Local Variables:
' @local byteCount - bytes of the case
' @local expectedUnused - bytes the last block of the size leaves unused
' @local bFillsBlock - TRUE when the size is exactly the capacity of a head block or of a head block and a body block

    byteCount := caseBytes(caseIdx)
    setCaseName(@edgeWriteFile, caseIdx)
    setCaseName(@edgeCreateFile, caseIdx)
    utils.startTest(caseTitle(@"file_size_unused() of a file ", caseIdx))
    debug("  bytes: ", udec_(byteCount))

    _, expectedUnused := layoutOf(byteCount)
    bFillsBlock := byteCount == HEAD_FULL_BYTES or byteCount == TWO_FULL_BYTES
    utils.evaluateSubValue(flash.file_size_unused(@edgeWriteFile), @"file_size_unused() of the written file", expectedUnused)
    utils.evaluateSubValue(flash.file_size_unused(@edgeCreateFile), @"file_size_unused() of the created file", expectedUnused)
    utils.evaluateSubValue(flash.file_size_unused(@edgeWriteFile) == NO_BYTES, @"no unused byte exactly when the size fills a block", bFillsBlock)


PRI testNewBlockStarts()
' The byte after a full block goes into a new block, for the head block and for the head block with one body block.

    utils.startTestGroup(@"the byte after a full block")
    newBlockCase(@"one byte over a full head block starts a body block", CASE_HEAD_FULL, CASE_HEAD_ABOVE)
    newBlockCase(@"one byte over a full head block and body block starts a second body block", CASE_TWO_FULL, CASE_TWO_ABOVE)


PRI newBlockCase(pTitle, fullCase, aboveCase)
' Check a file one byte over a full block occupies one more block than the full file, and that its last block holds that one byte, as one test.

' @param pTitle - address of zstring naming the test
' @param fullCase - the case whose size exactly fills the last block
' @param aboveCase - the case whose size is one byte more

    utils.startTest(pTitle)
    utils.evaluateSubValue(LONG[@writeBlocks][aboveCase], @"blocks of the written file one byte over", LONG[@writeBlocks][fullCase] + 1)
    utils.evaluateSubValue(LONG[@createBlocks][aboveCase], @"blocks of the created file one byte over", LONG[@createBlocks][fullCase] + 1)
    setCaseName(@edgeWriteFile, aboveCase)
    setCaseName(@edgeCreateFile, aboveCase)
    utils.evaluateSubValue(flash.file_size_unused(@edgeWriteFile), @"unused bytes of the written file one byte over", flash.BYTES_IN_BODY_BLOCK - ONE_BYTE)
    utils.evaluateSubValue(flash.file_size_unused(@edgeCreateFile), @"unused bytes of the created file one byte over", flash.BYTES_IN_BODY_BLOCK - ONE_BYTE)


PRI testRoundTrips()
' A 64 KB file and a 1 MB file, each written and read back through one chunk buffer and compared by CRC.

    utils.startTestGroup(@"round trips compared by CRC")
    roundTripCase(@"64 KB written and read back, CRC of the data read equals CRC of the data written", @mediumFile, MEDIUM_BYTES, SEED_MEDIUM)
    roundTripCase(@"1 MB written and read back, CRC of the data read equals CRC of the data written", @largeFile, LARGE_BYTES, SEED_LARGE)


PRI roundTripCase(pTitle, pFilename, byteCount, seed) | neededBlocks, freeBlocks, handle, status, writtenCount, writeCrc, readCount, readCrc
' Check the flash has room for a file, write it in chunks, read it back in chunks and compare the two CRCs, as one test.

' @param pTitle - address of zstring naming the test
' @param pFilename - address of zstring with the file name
' @param byteCount - bytes of the file
' @param seed - number that makes the pattern differ from patterns of other seeds

' Local Variables:
' @local neededBlocks - blocks the file occupies
' @local freeBlocks - free blocks the filesystem has
' @local handle - handle of the file
' @local status - status of the open, close and file size
' @local writtenCount - bytes the driver took
' @local writeCrc - CRC of the data written
' @local readCount - bytes the driver returned
' @local readCrc - CRC of the data read back

    utils.startTest(pTitle)
    debug("  bytes: ", udec_(byteCount))

    neededBlocks, _ := layoutOf(byteCount)
    freeBlocks := freeBlockCount()
    utils.evaluateSubValue(freeBlocks >= neededBlocks + SPARE_BLOCKS, @"free blocks hold the file and the spare blocks", TRUE)

    handle, status := utils.openWaitOnHandle(pFilename, flash.FILEMODE_WRITE)
    utils.evaluateSubStatus(status, @"open(,w)", flash.SUCCESS)
    if status == flash.SUCCESS
        writtenCount, writeCrc := writeStream(handle, byteCount, seed)
        utils.evaluateSubValue(writtenCount, @"bytes written", byteCount)
        status := utils.closeHandle(handle)
        utils.evaluateSubStatus(status, @"close() of the written file", flash.SUCCESS)
        utils.evaluateSubValue(flash.file_size(pFilename), @"file_size()", byteCount)

        handle, status := utils.openWaitOnHandle(pFilename, flash.FILEMODE_READ)
        utils.evaluateSubStatus(status, @"open(,r)", flash.SUCCESS)
        if status == flash.SUCCESS
            readCount, readCrc := readStream(handle, byteCount)
            utils.evaluateSubValue(readCount, @"bytes read", byteCount)
            utils.evaluateSubValue(readCrc, @"CRC of the data read back", writeCrc)
            status := utils.closeHandle(handle)
            utils.evaluateSubStatus(status, @"close() of the read file", flash.SUCCESS)


PRI writeStream(handle, byteCount, seed) : writtenCount, streamCrc | chunkLen, chunkCount, writeCount
' Write the pattern bytes of offsets 0 up to byteCount through a handle, one chunk at a time, and reduce the CRC of each chunk to one CRC.

' @param handle - handle of the file open for writing
' @param byteCount - number of bytes to write
' @param seed - number that makes the pattern differ from patterns of other seeds
' @returns writtenCount - bytes the driver accepted, less than byteCount when a write fell short
' @returns streamCrc - CRC of the CRCs of the chunks written

' Local Variables:
' @local chunkLen - bytes in the chunk being written
' @local chunkCount - chunks written
' @local writeCount - bytes the driver took from the chunk

    writtenCount := 0
    chunkCount := 0
    repeat while writtenCount < byteCount
        chunkLen := (byteCount - writtenCount) <# CHUNK_BYTES
        fillPattern(@chunkBuf, writtenCount, chunkLen, seed)
        LONG[@writeDigests][chunkCount] := getcrc(@chunkBuf, CRC_POLYNOMIAL, chunkLen)
        writeCount := flash.write(handle, @chunkBuf, chunkLen)
        chunkCount++
        if writeCount > 0
            writtenCount += writeCount
        if writeCount <> chunkLen
            quit
    streamCrc := getcrc(@writeDigests, CRC_POLYNOMIAL, chunkCount * BYTES_PER_LONG)


PRI readStream(handle, byteCount) : readTotal, streamCrc | chunkLen, chunkCount, readCount
' Read a file through a handle, one chunk at a time, and reduce the CRC of each chunk to one CRC.

' @param handle - handle of the file open for reading, positioned at its first byte
' @param byteCount - number of bytes to read
' @returns readTotal - bytes the driver returned, less than byteCount when a read fell short
' @returns streamCrc - CRC of the CRCs of the chunks read

' Local Variables:
' @local chunkLen - bytes asked for by the read being made
' @local chunkCount - chunks read
' @local readCount - bytes the driver returned for the chunk

    readTotal := 0
    chunkCount := 0
    repeat while readTotal < byteCount
        chunkLen := (byteCount - readTotal) <# CHUNK_BYTES
        bytefill(@chunkBuf, POISON_BYTE, chunkLen)
        readCount := flash.read(handle, @chunkBuf, chunkLen)
        LONG[@readDigests][chunkCount] := getcrc(@chunkBuf, CRC_POLYNOMIAL, readCount)
        chunkCount++
        readTotal += readCount
        if readCount <> chunkLen
            quit
    streamCrc := getcrc(@readDigests, CRC_POLYNOMIAL, chunkCount * BYTES_PER_LONG)


PRI checkLayout(pFilename, byteCount, usedByFile)
' Check a file's size and the blocks it occupies against the layout computed for its size.

' @param pFilename - address of zstring with the file name
' @param byteCount - bytes the file holds
' @param usedByFile - blocks stats() showed the file to occupy

    utils.evaluateSubValue(flash.file_size(pFilename), @"file_size()", byteCount)
    utils.evaluateSubValue(usedByFile, @"blocks the file occupies", layoutBlocks(byteCount))


PRI checkReadBack(pFilename, byteCount) | handle, status, readCount, pastCount
' Read a file whole into the read buffer, compare it with the model buffer, and check a further read finds the end of the file.

' @param pFilename - address of zstring with the file name
' @param byteCount - bytes the file holds, and the bytes of the model buffer

' Local Variables:
' @local handle - handle of the file being read
' @local status - status of the open and of the close
' @local readCount - bytes the whole read returned
' @local pastCount - bytes the read past the last byte returned

    bytefill(@readBuf, POISON_BYTE, byteCount)
    handle, status := utils.openWaitOnHandle(pFilename, flash.FILEMODE_READ)
    utils.evaluateSubStatus(status, @"open(,r)", flash.SUCCESS)
    if status == flash.SUCCESS
        readCount := flash.read(handle, @readBuf, byteCount)
        utils.evaluateSubValue(readCount, @"read()", byteCount)
        utils.evaluateSubValue(firstMismatch(@modelBuf, @readBuf, byteCount), @"first byte that differs", NO_MISMATCH)
        pastCount := flash.read(handle, @oneByte, ONE_BYTE)
        utils.evaluateSubValue(pastCount, @"read() past the last byte", NO_BYTES)
        utils.evaluateSubStatus(flash.error(), @"error() after the read past the last byte", flash.E_END_OF_FILE)
        status := utils.closeHandle(handle)
        utils.evaluateSubStatus(status, @"close()", flash.SUCCESS)


PRI caseBytes(caseIdx) : byteCount
' Give the size of a case.

' @param caseIdx - the size case, one of the CASE_ values
' @returns byteCount - bytes of the case

    case caseIdx
        CASE_HEAD_BELOW: byteCount := HEAD_FULL_BYTES - ONE_BYTE
        CASE_HEAD_FULL: byteCount := HEAD_FULL_BYTES
        CASE_HEAD_ABOVE: byteCount := HEAD_FULL_BYTES + ONE_BYTE
        CASE_TWO_BELOW: byteCount := TWO_FULL_BYTES - ONE_BYTE
        CASE_TWO_FULL: byteCount := TWO_FULL_BYTES
        other: byteCount := TWO_FULL_BYTES + ONE_BYTE


PRI caseEdge(caseIdx) : pEdge
' Give the words that finish the title of a test of a case.

' @param caseIdx - the size case, one of the CASE_ values
' @returns pEdge - address of zstring describing the size

    case caseIdx
        CASE_HEAD_BELOW: pEdge := @"one byte short of a full head block"
        CASE_HEAD_FULL: pEdge := @"exactly a full head block"
        CASE_HEAD_ABOVE: pEdge := @"one byte over a full head block"
        CASE_TWO_BELOW: pEdge := @"one byte short of a full head block and body block"
        CASE_TWO_FULL: pEdge := @"exactly a full head block and body block"
        other: pEdge := @"one byte over a full head block and body block"


PRI caseTitle(pPrefix, caseIdx) : pTitle | prefixLen
' Build the title of a test from the words of what is called and the words of the size.

' @param pPrefix - address of zstring with the start of the title
' @param caseIdx - the size case, one of the CASE_ values
' @returns pTitle - address of zstring with the title, valid until the next call

' Local Variables:
' @local prefixLen - characters of the start of the title

    strcopy(@titleBuf, pPrefix, TITLE_BYTES - 1)
    prefixLen := strsize(@titleBuf)
    strcopy(@titleBuf + prefixLen, caseEdge(caseIdx), TITLE_BYTES - 1 - prefixLen)
    pTitle := @titleBuf


PRI setCaseName(pTemplate, caseIdx)
' Put the number of a case in the name of the edge file of that case.

' @param pTemplate - address of the name template of the edge files
' @param caseIdx - the size case, one of the CASE_ values

    BYTE[pTemplate][NAME_DIGIT_OFFSET] := "0" + caseIdx


PRI layoutOf(byteCount) : blockCount, unusedBytes | capacityBytes
' Find how many blocks hold a size and how many bytes the last block leaves unused, by filling blocks until their capacity covers the size.

' @param byteCount - bytes of the file
' @returns blockCount - blocks the file occupies
' @returns unusedBytes - bytes the last block leaves unused

' Local Variables:
' @local capacityBytes - bytes the blocks counted so far hold

    blockCount := 1
    capacityBytes := flash.BYTES_IN_HEAD_BLOCK
    repeat while capacityBytes < byteCount
        blockCount++
        capacityBytes += flash.BYTES_IN_BODY_BLOCK
    unusedBytes := capacityBytes - byteCount


PRI layoutBlocks(byteCount) : blockCount
' Find how many blocks hold a size.

' @param byteCount - bytes of the file
' @returns blockCount - blocks the file occupies

    blockCount, _ := layoutOf(byteCount)


PRI usedBlocks() : blockCount
' Count the blocks in use in the filesystem.

' @returns blockCount - blocks in use

    blockCount, _, _ := flash.stats()


PRI freeBlockCount() : blockCount
' Count the free blocks of the filesystem.

' @returns blockCount - free blocks

    _, blockCount, _ := flash.stats()


PRI patternByte(fileOffset, seed) : patternValue
' Compute the byte a pattern holds at a file offset.

' @param fileOffset - offset of the byte from the start of the pattern
' @param seed - number that makes this pattern differ from patterns of other seeds
' @returns patternValue - the byte at the offset

    patternValue := (fileOffset + (fileOffset >> PATTERN_PAGE_SHIFT) + seed) & BYTE_MASK


PRI fillPattern(pBuffer, startOffset, byteCount, seed) | byteIdx
' Fill a buffer with a repeatable pattern that differs by seed and by 256-byte page, starting at a pattern offset.

' @param pBuffer - address of the buffer to fill
' @param startOffset - pattern offset of the first byte of the buffer
' @param byteCount - number of bytes to fill
' @param seed - number that makes this pattern differ from patterns of other seeds

' Local Variables:
' @local byteIdx - number of the byte being filled

    repeat byteCount with byteIdx
        BYTE[pBuffer][byteIdx] := patternByte(startOffset + byteIdx, seed)


PRI firstMismatch(pFirst, pSecond, byteCount) : mismatchIdx | byteIdx
' Find the first byte at which two buffers differ.

' @param pFirst - address of the first buffer
' @param pSecond - address of the second buffer
' @param byteCount - number of bytes to compare
' @returns mismatchIdx - offset of the first differing byte, or NO_MISMATCH when the buffers agree

' Local Variables:
' @local byteIdx - number of the byte being compared

    mismatchIdx := NO_MISMATCH
    repeat byteCount with byteIdx
        if BYTE[pFirst][byteIdx] <> BYTE[pSecond][byteIdx]
            mismatchIdx := byteIdx
            quit


con { license }

